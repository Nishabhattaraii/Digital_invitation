rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read and admin writes to wedding documents and photos
    match /weddings/{document=**} {
      allow read, write: if true;
    }
    match /wedding_photos/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
